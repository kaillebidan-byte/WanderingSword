{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_inventory.schema.json",
  "title": "Story context candidate inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "generator_version",
    "status",
    "source",
    "policy",
    "summary",
    "quest_groups",
    "scene_families",
    "candidate_links",
    "duplicate_title_clusters",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "story-context-preparation-v1"
    },
    "generator_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "candidate_only"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "entries"
      ],
      "properties": {
        "path": {
          "const": "_phase4_proofread/source_zh.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "ordering_declared",
        "formal_reference_allowed",
        "active_event_selected",
        "allowed_link_reasons",
        "numeric_proximity_is_not_evidence",
        "candidate_links_require_manual_event_review"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "ordering_declared": {
          "const": false
        },
        "formal_reference_allowed": {
          "const": false
        },
        "active_event_selected": {
          "const": false
        },
        "allowed_link_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "same_numeric_root",
              "shared_dialogue_fingerprint",
              "quest_title_mention"
            ]
          }
        },
        "numeric_proximity_is_not_evidence": {
          "const": true
        },
        "candidate_links_require_manual_event_review": {
          "const": true
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "quest_groups": {
      "type": "array"
    },
    "scene_families": {
      "type": "array"
    },
    "candidate_links": {
      "type": "array"
    },
    "duplicate_title_clusters": {
      "type": "array"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
