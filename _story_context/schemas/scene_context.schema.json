{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaillebidan-byte/WanderingSword/_story_context/schemas/scene_context.schema.json",
  "title": "Scene-Time Story Context",
  "description": "Knowledge and belief available at the scene only. Later truth and reveal information are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "layer", "scenes", "source_keys"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "layer": {"const": "scene_time"},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["scene_id", "order", "player_knowledge_before", "player_knowledge_after", "character_knowledge", "beliefs_and_misunderstandings", "uncertainties", "source_keys"], "properties": {"scene_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "order": {"type": "integer", "minimum": 1}, "player_knowledge_before": {"type": "array", "items": {"type": "string"}}, "player_knowledge_after": {"type": "array", "items": {"type": "string"}}, "character_knowledge": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "beliefs_and_misunderstandings": {"type": "array", "items": {"type": "string"}}, "uncertainties": {"type": "array", "items": {"type": "string"}}, "source_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "source_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
