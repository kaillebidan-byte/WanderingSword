{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaillebidan-byte/WanderingSword/_story_context/schemas/spoiler_context.schema.json",
  "title": "Full-Spoiler Story Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "layer", "truths", "reveal_order", "source_keys"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "layer": {"const": "full_spoiler"},
    "truths": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["truth_id", "statement", "source_keys"], "properties": {"truth_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "statement": {"type": "string", "minLength": 1}, "source_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "reveal_order": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["order", "truth_id", "reveal_kind", "scene_id", "source_keys"], "properties": {"order": {"type": "integer", "minimum": 1}, "truth_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "reveal_kind": {"enum": ["hint", "partial", "apparent", "confirmed", "recontextualized"]}, "scene_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "source_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "source_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
