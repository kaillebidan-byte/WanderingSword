    {
      "key": "6155_3_Dlgs_Index1_Text",
      "speaker": "欧阳雪",
      "zh": "17005 - 欧阳雪 $@$逸哥哥！",
      "ja": "17005 - 欧陽雪 $@$逸兄さま！"
    },
    {
      "key": "6155_3_Dlgs_Index2_Text",
      "speaker": "欧阳雪",
      "zh": "17005 - 欧阳雪 $@$咳咳，莫问大哥不要再逼他了……",
      "ja": "17005 - 欧陽雪 $@$ごほっ、ごほっ……莫問兄さま、もう逸兄さまを追い詰めないで……"
    },
    {
      "key": "6155_3_Dlgs_Index3_Text",
      "speaker": "欧阳雪",
      "zh": "17005 - 欧阳雪 $@$……在他心里，你永远都是他的师兄，从未想过真的要和你分出生死！",
      "ja": "17005 - 欧陽雪 $@$……逸兄さまにとって、莫問兄さまはいつまでも師兄なのです。生死を分かつなど、考えたこともありません！"
    },
    {
      "key": "6155_3_Dlgs_Index5_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$有时候，还真是嫉妒他啊。",
      "ja": "45311 - 莫問 $@$時には……あいつが羨ましくもなる。"
    },
    {
      "key": "6155_3_Dlgs_Index6_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$同样无父无母，他的身边却从来不缺诚心以待之人……",
      "ja": "45311 - 莫問 $@$同じように父も母もいないのに、あいつのそばには、いつも真心を向けてくれる者がいる……"
    },
    {
      "key": "6155_3_Dlgs_Index7_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$只可惜事已至此，总是需要一个了结的。",
      "ja": "45311 - 莫問 $@$だが、ここまで来た以上、決着はつけねばならない。"
    },
    {
      "key": "6155_3_Dlgs_Index8_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$既然他已没了斗志……",
      "ja": "45311 - 莫問 $@$もう戦う気がないのなら……"
    },
    {
      "key": "6155_3_Dlgs_Index9_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$那就从他最在乎的你开始吧……",
      "ja": "45311 - 莫問 $@$まずは、あいつが一番大切にしているお前からだ……"
    },
    {
      "key": "6158_5_Dlgs_Index0_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$不是说要阻止我吗，咳咳……",
      "ja": "45311 - 莫問 $@$わたしを止めるんじゃなかったのか……ごほっ、ごほっ……"
    },
    {
      "key": "6158_5_Dlgs_Index1_Text",
      "speaker": "莫问",
      "zh": "45311 - 莫问 $@$今日你不杀我，迟早有一天会后悔的！",
      "ja": "45311 - 莫問 $@$今日、わたしを殺さなければ、いつか必ず後悔するぞ！"
    },
    {
      "key": "6158_5_Dlgs_Index2_Text",
      "speaker": "宇文逸",
      "zh": "1 - 宇文逸 $@$没关系……",
      "ja": "1 - 宇文逸 $@$構いません……"
