      "allusion_review_resolved": [
        {
          "key": "5353_5_Dlgs_Index0_Text",
          "decision": "技名として原語維持",
          "note": "「袖里乾坤」は杜彪の暗器技を指す技名。特定典籍の引用として読み下さず、既訳の「袖裡乾坤」を保持する。"
        },
        {
          "key": "5353_5_Dlgs_Index16_Text",
          "decision": "定着した格言",
          "note": "「士可杀不可辱」は命より名誉を重んじる定着格言。特定出典の直引用へ過剰同定せず、「士は殺されても辱めは受けぬ」で格調と反抗を保つ。"
        },
        {
          "key": "5353_5_Dlgs_Index17_Text",
          "decision": "定着した挑発表現",
          "note": "「放马过来」は相手へ攻撃を促す定着表現。現訳の「やれるものなら、かかってこい」で挑発機能と勢いを保つ。"
        },
        {
          "key": "5353_5_Dlgs_Index19_Text",
          "decision": "仏教・民間信仰の定着語",
          "note": "「阎罗殿」は死後の裁きの場を指す定着語。引用句ではなく、現訳の「閻羅殿」を保持する。"
        },
        {
          "key": "5358_1_Dlgs_Index10_Text",
          "decision": "古典由来の定着成語",
          "note": "「既来之则安之」は『論語』季氏篇に由来するが、ここでは宿へ来た以上ひとまず落ち着くという成語機能。現訳は場面に合わせて「ここまで来たのだ。ひとまず休ませてもらおう」と保持する。"
        },
        {
          "key": "5352_3_Dlgs_Index7_Text",
          "decision": "定着した成語",
          "note": "「无坚不摧」は何ものも破れないほど鋭いという誇張成語。莫棄の伝聞と誇張として「斬れぬものなし」を保持し、無塵の客観性能へ一般化しない。"
        }
      ],
      "fact_doubts": [
