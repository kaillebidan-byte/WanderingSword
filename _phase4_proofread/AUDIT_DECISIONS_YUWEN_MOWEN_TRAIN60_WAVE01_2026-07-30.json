      "allusion_review_resolved": [
        {
          "key": "5531_3_Dlgs_Index0_Text",
          "decision": "定着した兵法成語",
          "note": "「穷寇莫追」は逃走する敵を追い詰めないという兵法系の定着表現。会話では特定典籍の朗誦ではなく制止として機能しており、現訳「逃げる敵を深追いするな」が意味と速度を保つ。"
        },
        {
          "key": "5522_1_Dlgs_Index3_Text",
          "decision": "通常の対句表現",
          "note": "「想来就来、想走就走」は勝手に出入りすることを責める並列表現で、特定典籍の引用ではない。現訳「好き勝手に出入りできると思うな」が徐海の怒号を保つ。"
        },
        {
          "key": "5525_6_Dlgs_Index1_Text",
          "decision": "定着した成語",
          "note": "「千方百计」はあらゆる手段を尽くす意の成語。現訳「あの手この手で」は瑶姬の推測口調と会話速度を保つ。"
        },
        {
          "key": "5528_7_Dlgs_Index4_Text",
          "decision": "定着した評価表現",
          "note": "「绝非易于之辈」は容易に扱える相手ではない意。現訳「侮れる相手ではない」は莫問の戦闘時の警告として機能と強度を保つ。"
        },
        {
          "key": "5531_4_Dlgs_Index23_Text",
          "decision": "定着した不可逆表現",
          "note": "「错已铸成」は過ちが既に成り、取り返せないという比喩的な通常表現。修正訳「もう取り返しがつかない」は徐海の悔恨と不可逆性を自然に保つ。"
        }
      ],
