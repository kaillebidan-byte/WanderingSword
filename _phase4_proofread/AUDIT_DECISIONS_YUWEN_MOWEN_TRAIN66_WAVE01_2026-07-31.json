      "allusion_review_resolved": [
        {"key": "5784_9_Dlgs_Index8_Text", "decision": "特定典籍の直接引用", "note": "「四海之内皆兄弟」は『論語』顔淵の「四海之内、皆兄弟也」にほぼ一致する著名句。伯父の言葉を程鈺が引用する場面なので、定着した読み下し「四海の内、皆兄弟なり」を採用する。"},
        {"key": "5781_1_Dlgs_Index10_Text", "decision": "定着した成語", "note": "「事半功倍」は少ない労力で大きな成果を得る意の定着成語。莫問が程堡主へ頼れば人捜しが効率化すると説明する機能を、現訳「ずっと早く進む」が自然に保つ。"},
        {"key": "5781_1_Dlgs_Index5_Text", "decision": "定着した継続表現", "note": "「数十年如一日」は長年変わらず続ける意の定着表現。特定典籍の引用として発声されておらず、現訳「数十年変わらず」で機能を保つ。"},
        {"key": "5781_1_Dlgs_Index9_Text", "decision": "定着した称賛の成語", "note": "「交口称赞」は口をそろえて称える意の成語。現訳の像を維持し、修正は正邪両道が掛かる節の境界だけに限定する。"},
        {"key": "5781_10_Dlgs_Index0_Text", "decision": "定着した称賛の成語", "note": "「赞不绝口」は絶えず褒める意の成語。現訳「絶賛しています」が場面機能を保つ。"},
        {"key": "5781_1_Dlgs_Index4_Text", "decision": "武侠の人物評価語", "note": "「侠骨」は侠義を備えた気骨を表す武侠語彙で、この行では特定典籍の引用ではない。現訳「侠気に厚く」を維持する。"}
      ],
