{
  "schema_version": 1,
  "contract_id": "translation-factory-flow-v1",
  "controller": "_tools/translation_factory_controller.py",
  "entrypoint": "python _tools/translation_factory_controller.py --repository-visibility <private|public>",
  "request_contract": "_phase4_proofread/FACTORY_REQUEST_CONTRACT.json",
  "execution_workflow": ".github/workflows/translation-factory-execute.yml",
  "encoding_workflow": ".github/workflows/translation-factory-encode.yml",
  "purpose": "翻訳者へ意味判断だけを残し、GitHub・状態遷移・輸送判断を決定論的な作業指示へ固定する。",
  "human_judgment_stations": [
    {
      "station_id": "semantic_bundle_boundary",
      "allowed_decisions": [
        "どこまでを一つの意味単位として同じpacketまたはwaveへ含めるか",
        "40〜60行で閉じるか、意味単位完結のため80行まで延長するか"
      ],
      "record_adapter": "_tools/fixed_cycle_initializer.py",
      "forbidden_operations": [
        "branch設計",
        "workflow設計",
        "GitHub API選択",
        "状態正本の直接編集",
        "翻訳fix確定",
        "owner書込み",
        "正式束番号確定"
      ]
    },
    {
      "station_id": "translation_quality_audit",
      "allowed_decisions": [
        "現訳を保持するか修正するか",
        "修正訳",
        "人物性・事実・典故に関する監査判断"
      ],
      "record_adapter": "_tools/fixed_encoding_pipeline.py",
      "forbidden_operations": [
        "branch設計",
        "workflow設計",
        "GitHub API選択",
        "状態正本の直接編集",
        "encoding",
        "CI起動",
        "merge"
      ]
    }
  ],
  "machine_owned_operations": [
    "repository_scope_and_visibility_read",
    "open_pr_triage",
    "execution_mode_lock",
    "branch_and_pr_transport",
    "workflow_and_artifact_lookup",
    "candidate_material_transport",
    "row_count_and_cap_validation",
    "owner_snapshot_and_conflict_checks",
    "state_authority_updates",
    "encoding_of_recorded_decisions",
    "locres_and_pak_generation",
    "release_preflight",
    "release_train_orchestration",
    "release_evidence_and_phase2",
    "commit_compaction",
    "squash_merge",
    "merged_cycle_reconciliation"
  ],
  "actions": {
    "initialize_next_cycle_from_reservation": {
      "station_type": "machine",
      "executor": "fixed_cycle_initializer",
      "adapter": "_tools/fixed_cycle_initializer.py",
      "request_operation": "initialize_with_semantic_boundary",
      "next_expected_station": "semantic_bundle_boundary",
      "persisted_result_after_boundary_input": "translation_quality_audit"
    },
    "semantic_bundle_boundary": {
      "station_type": "human",
      "executor": "semantic_boundary_form"
    },
    "advance_to_quality_audit": {
      "station_type": "machine",
      "executor": "fixed_stage_transition"
    },
    "translation_quality_audit": {
      "station_type": "human",
      "executor": "translation_audit_form"
    },
    "encode_recorded_decisions": {
      "station_type": "machine",
      "executor": "fixed_encoding_pipeline",
      "adapter": "_tools/fixed_encoding_pipeline.py",
      "trigger_record": "_phase4_proofread/AUDIT_DECISIONS_*.json",
      "execution_workflow": ".github/workflows/translation-factory-encode.yml",
      "resulting_stage": "translation_frozen",
      "resulting_transport": "ready_for_public_ci"
    },
    "run_release_preflight": {
      "station_type": "machine",
      "executor": "fixed_release_preflight"
    },
    "run_release_train": {
      "station_type": "machine",
      "executor": "release_train_orchestrator"
    },
    "finalize_release_state": {
      "station_type": "machine",
      "executor": "fixed_release_finalizer"
    },
    "verify_phase2_and_merge": {
      "station_type": "machine",
      "executor": "fixed_phase2_merge_pipeline"
    },
    "reconcile_merged_cycle": {
      "station_type": "machine",
      "executor": "reconcile_merged_cycle"
    },
    "resume_recorded_checkpoint": {
      "station_type": "machine",
      "executor": "recorded_exact_next_action"
    }
  },
  "retry_policy": {
    "known_transient_max_retries": 1,
    "unknown_failure_max_retries": 0,
    "same_arguments_retry_forbidden": true,
    "failed_step_logs_required_before_retry": true
  },
  "forbidden_fallbacks": [
    "web_search_for_github_api_usage",
    "ad_hoc_workflow_generation",
    "alternate_trigger_experiments",
    "unmapped_api_experiments",
    "same_failed_arguments_retry",
    "translation_content_change_in_machine_station",
    "manual_state_authority_edit_outside_station"
  ],
  "error_policy": {
    "unknown_state": "factory_unknown_state",
    "state_mismatch": "factory_state_mismatch",
    "missing_adapter": "factory_adapter_missing",
    "action_not_in_contract": "factory_unmapped_action",
    "stop_without_fallback": true
  }
}
