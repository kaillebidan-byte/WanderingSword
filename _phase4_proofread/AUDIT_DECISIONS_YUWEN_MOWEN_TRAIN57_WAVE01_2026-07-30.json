      "allusion_review_resolved": [
        {
          "key": "5358_5_Dlgs_Index5_Text",
          "decision": "武功体系名として原語維持",
          "note": "「少林七十二绝技」は少林の武功体系を指す固有名。技名・武功名の規則に従い、日本語字形の「少林七十二絶技」を保持する。"
        },
        {
          "key": "5358_5_Dlgs_Index5_Text",
          "decision": "武功名として原語維持",
          "note": "「禅宗伏魔功」は慧空が修めた武功名。古典句として読み下さず、既訳の「禅宗伏魔功」を保持する。"
        },
        {
          "key": "5358_5_Dlgs_Index6_Text",
          "decision": "仏教の定型念仏",
          "note": "「阿弥陀佛」は慧空が謙遜や謝意の前に唱える定型句。既定の日本語形「南無阿弥陀仏」を保持し、5358_5のIndex17・Index24も同じ機能として扱う。"
        },
        {
          "key": "5358_5_Dlgs_Index15_Text",
          "decision": "定着した諺",
          "note": "「与人方便与己方便」は人に便宜を図れば自分にも返るという定着した諺。宇文逸が相互扶助を勧める場面では「困ったときはお互いさま」が機能と温度を保つため保持する。"
        },
        {
          "key": "5358_5_Dlgs_Index22_Text",
          "decision": "定着した約束表現",
          "note": "「不见不散」は会うまで待つという約束の定型表現。慧平の「必ず落ち合おう」と宇文逸の「約束ですよ」は連続発話として自然で、字面の反復より場面機能を保っている。"
        },
        {
          "key": "5359_5_Dlgs_Index0_Text",
          "decision": "定着した成語",
          "note": "「坐以待毙」は何もせず死を待つ意の成語。現訳の「座して死を待つ」は像と切迫を保ち、莫問の危機判断として自然なため保持する。"
        }
      ],
      "fact_doubts": [
